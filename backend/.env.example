# Personal Red Team Backend Configuration
# Copy this file to .env and update values for production

# Database
DATABASE_URL=sqlite+aiosqlite:///./personal_red_team.db

# Security - CHANGE THIS IN PRODUCTION
SECRET_KEY=change-this-to-a-random-secret-key

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_API=60/minute

# Password Policy
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=128

# Email (Resend) - Get API key from https://resend.com
RESEND_API_KEY=
EMAIL_FROM=noreply@personalredteam.com
FRONTEND_URL=http://localhost:3000

# Password Reset
PASSWORD_RESET_EXPIRE_MINUTES=30

# 2FA (TOTP)
TOTP_ISSUER=Personal Red Team

# Debug mode - disable in production
DEBUG=true
